# Variáveis do ambiente local (compose.yaml). Copie para .env para sobrescrever.
# Valores triviais, válidos SOMENTE para desenvolvimento local.

# Senha do usuário "skyledger" no PostgreSQL. Lida pelo compose.yaml e pela
# aplicação (obrigatória para ela). No PostgreSQL, só é aplicada ao inicializar
# um volume vazio; para trocar depois, remova o volume (docker compose down -v).
POSTGRES_PASSWORD=skyledger

# Credenciais da API S3 do SeaweedFS (http://localhost:8333).
S3_ACCESS_KEY=skyledger-dev
S3_SECRET_KEY=skyledger-dev-secret

# Raiz do repositório anac-data, lida pela ingestão (POST /api/ingestions).
# Relativa à raiz deste repositório ou absoluta.
ANAC_DATA_PATH=../anac-data
